# Copie este arquivo para .env.local — é de lá que o Next.js e o Prisma CLI leem.
#
# Postgres do Supabase.
# Settings > Database > Connection string, no painel do projeto.
#
# DATABASE_URL usa o pooler (porta 6543) — é o que a aplicação abre em runtime.
# DIRECT_URL usa a conexão direta (porta 5432) — é o que `prisma migrate` precisa.
DATABASE_URL="postgresql://postgres.PROJECT_REF:SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECT_REF:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres"

# Admin criado pelo seed.
SEED_ADMIN_NOME="Arthur Sandim"
SEED_ADMIN_EMAIL="arthur.s@nextar.com.br"
