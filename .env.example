# Copie para .env.local. Nada aqui recebe valor real — .env.local é ignorado
# pelo git, este arquivo não.

# Postgres do Supabase (Settings > Database > Connection string).
# DATABASE_URL: pooler de transação (6543), usado pela app em runtime.
# DIRECT_URL:   pooler de sessão (5432), usado por `prisma migrate`.
DATABASE_URL=
DIRECT_URL=

# Supabase Auth. Só estas duas podem ter o prefixo NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave sb_secret_: ignora Row Level Security e só o servidor lê.
# Nunca com prefixo NEXT_PUBLIC_, que a inlina no bundle do navegador.
SUPABASE_SECRET_KEY=

# Admin criado pelo seed. Sem SEED_ADMIN_SENHA, o seed sorteia uma senha e a
# imprime uma única vez no terminal.
SEED_ADMIN_NOME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_SENHA=
